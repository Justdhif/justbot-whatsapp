# Bot Service Environment Variables Example

PORT=3000
HOST=0.0.0.0

GROQ_API_KEY=your_groq_api_key_here
WA_VERIFY_TOKEN=your_webhook_verify_token
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_CLOUD_API_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token

BOT_ENABLE_SCHEDULE=true
BOT_OPERATIONAL_START=08:00
BOT_OPERATIONAL_END=21:00
BOT_OPERATIONAL_DAYS=1,2,3,4,7
