# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=justbot-api

# ──────────────────────────────────────────────────────────────────────────────
# Database (Neon Postgres)
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ──────────────────────────────────────────────────────────────────────────────
# JWT — Token Strategy (Sliding Session)
# Access token: short-lived (7d), Refresh token: long-lived (365d) with rotation
# On every refresh, old token is invalidated and new pair is issued.
# This mimics Instagram/TikTok "always logged in" behavior.
# ──────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_long_access_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_long_refresh_secret_min_32_chars_here
JWT_REFRESH_EXPIRES_IN=365d

# ──────────────────────────────────────────────────────────────────────────────
# CORS (comma-separated list of allowed origins)
# ──────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# THROTTLE_TTL: time window in milliseconds (900000 = 15 minutes)
# THROTTLE_LIMIT: max requests per window
# ──────────────────────────────────────────────────────────────────────────────
THROTTLE_TTL=900000
THROTTLE_LIMIT=100
